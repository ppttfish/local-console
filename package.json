{
  "name": "local-console",
  "productName": "小福鱼",
  "version": "0.4.5",
  "description": "本地服务与批处理任务的统一管理面板；MCP-first，agent 原生可调用。订阅监控：AI 服务商配额一屏掌控。",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "start": "electron .",
    "start:web": "electron out/main/http-standalone.cjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --dir",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "release": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64",
    "mcp": "electron out/main/mcp/standalone.cjs"
  },
  "bin": {
    "lcp": "out/cli/lcp.js"
  },
  "author": "you",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "png-to-ico": "^3.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@vueuse/core": "^14.4.0",
    "better-sqlite3": "^11.1.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fzstd": "^0.1.1",
    "lucide-vue-next": "^0.577.0",
    "motion-v": "^2.4.0",
    "pinia": "^2.2.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.4.38",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.4.3"
  },
  "build": {
    "appId": "com.localconsole.app",
    "productName": "小福鱼",
    "copyright": "© 2026 Local Console",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/.DS_Store",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "out/renderer",
        "to": "renderer"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "local-console-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "local-console-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "local-console-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "local-console-${version}-${arch}.${ext}",
      "identity": null
    },
    "asar": true,
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "ppttfish",
      "repo": "local-console",
      "releaseType": "release"
    }
  }
}
